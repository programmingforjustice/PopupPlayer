<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/item_file_entry.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!--
        썸네일: 너비 100dp 고정, 높이는 16:9 비율로 자동 계산.
        ConstraintLayout + dimensionRatio 로 기기 무관하게 비율 유지.
        bg_grid_thumb(radius=10dp) + clipToOutline 으로 모서리 둥글게.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_grid_thumb"
        android:clipToOutline="true">

        <!-- ivEntryThumbnail: 16:9 비율 -->
        <ImageView
            android:id="@+id/ivEntryThumbnail"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:background="#E8ECF0"
            android:contentDescription="thumbnail"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintDimensionRatio="W,9:16" />

        <!-- ivPlayOverlay: 동영상일 때만 visible -->
        <ImageView
            android:id="@+id/ivPlayOverlay"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_media_play"
            android:alpha="0.85"
            android:visibility="gone"
            android:contentDescription="Play"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- tvDuration: 재생시간 (우하단) -->
        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="#AA000000"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- tvGifBadge: GIF일 때만 visible -->
        <TextView
            android:id="@+id/tvGifBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:text="GIF"
            android:textSize="9sp"
            android:textColor="#FFFFFF"
            android:background="#CC000000"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 이름 + 서브텍스트 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvEntryName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#111111"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.1" />

        <TextView
            android:id="@+id/tvEntrySubtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- ivEntryAction: 폴더 → 화살표, 파일 → 더보기 -->
    <ImageView
        android:id="@+id/ivEntryAction"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_media_next"
        android:alpha="0.4"
        android:contentDescription="action" />

</LinearLayout>