<?xml version="1.0" encoding="utf-8"?>
<!--
    PlaylistBottomSheet 의 루트 레이아웃
    ─────────────────────────────────────────────────────────────
    • viewSelectPlaylist : 기존 플레이리스트 선택 화면 (bottom_sheet_playlist.xml 내용 인라인)
    • viewNewPlaylist    : 신규 플레이리스트 생성 화면 (bottom_sheet_new_playlist.xml 내용 인라인)
    두 뷰를 FrameLayout 으로 겹쳐 두고, visibility 전환으로 화면 전환.
    ─────────────────────────────────────────────────────────────
    파일 위치: res/layout/bottom_sheet_playlist_container.xml
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- ① 플레이리스트 선택 화면 -->
    <LinearLayout
        android:id="@+id/viewSelectPlaylist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:paddingBottom="24dp"
        android:visibility="visible">

        <!-- 드래그 핸들 -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="#DDDDDD"
            android:importantForAccessibility="no" />

        <!-- 타이틀 -->
        <TextView
            android:id="@+id/tvPlaylistSheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:text="1 video toevoegen aan playlist"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />

        <!-- 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0"
            android:layout_marginBottom="12dp" />

        <!-- 신규 플레이리스트 생성 버튼 -->
        <LinearLayout
            android:id="@+id/btnNewPlaylist"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_new_playlist_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_playlist_add"
                android:tint="#1A73E8"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Nieuwe playlist aanmaken"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A73E8" />

        </LinearLayout>

        <!-- 기존 플레이리스트 RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlaylists"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- 비어있을 때 -->
        <TextView
            android:id="@+id/tvPlaylistEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"
            android:text="아직 플레이리스트가 없습니다.\n'Nieuwe playlist aanmaken' 을 눌러 추가하세요."
            android:textSize="13sp"
            android:textColor="#888888"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ② 신규 플레이리스트 생성 화면 -->
    <LinearLayout
        android:id="@+id/viewNewPlaylist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:paddingBottom="32dp"
        android:visibility="gone">

        <!-- 드래그 핸들 -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:background="#DDDDDD"
            android:importantForAccessibility="no" />

        <!-- 타이틀 행 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="20dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_playlist_add"
                android:tint="#1A1A1A"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Nieuwe playlist aanmaken"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" />

        </LinearLayout>

        <!-- 이름 입력 + 생성 버튼 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPlaylistName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPlaylistName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Naam playlist invoeren"
                    android:inputType="textCapSentences"
                    android:imeOptions="actionDone"
                    android:maxLines="1"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnCreatePlaylist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aanmaken"
                android:textSize="14sp"
                android:enabled="false"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
