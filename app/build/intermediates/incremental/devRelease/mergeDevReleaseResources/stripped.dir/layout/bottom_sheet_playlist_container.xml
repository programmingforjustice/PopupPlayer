<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- ① 플레이리스트 선택 화면 -->
    <LinearLayout
        android:id="@+id/viewSelectPlaylist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:paddingBottom="20dp"
        android:visibility="visible">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="#DDDDDD"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvPlaylistSheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="12dp"
            android:text="1 video toevoegen aan playlist"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/btnNewPlaylist"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_new_playlist_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_menu_playlist"
                android:tint="#1A73E8"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Nieuwe playlist aanmaken"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1A73E8" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlaylists"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/tvPlaylistEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:text="아직 플레이리스트가 없습니다.\n'Nieuwe playlist aanmaken' 을 눌러 추가하세요."
            android:textSize="13sp"
            android:textColor="#888888"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ② 신규 플레이리스트 생성 화면 -->
    <LinearLayout
        android:id="@+id/viewNewPlaylist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#DDDDDD"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_menu_playlist"
                android:tint="#1A1A1A"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Nieuwe playlist aanmaken"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" />

        </LinearLayout>

        <!-- 입력창 + 버튼 행 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etPlaylistName"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:minHeight="0dp"
                android:hint="Naam playlist invoeren"
                android:textSize="14sp"
                android:textColor="#111111"
                android:textColorHint="#AAAAAA"
                android:inputType="textCapSentences"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/bg_edittext_outlined" />

            <Button
                android:id="@+id/btnCreatePlaylist"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Aanmaken"
                android:textSize="14sp"
                android:textColor="@color/btn_playlist_create_text"
                android:enabled="false"
                android:backgroundTint="@color/btn_playlist_create_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>