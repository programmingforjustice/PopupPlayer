<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/bottom_sheet_file_menu.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <!-- 파일 이름 (타이틀) -->
    <TextView
        android:id="@+id/tvMenuFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#111111"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="8dp" />

    <!-- 즐겨찾기 추가 -->
    <LinearLayout
        android:id="@+id/menuFavorite"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_menu_favorite"
            android:contentDescription="즐겨찾기" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="즐겨찾기 추가"
            android:textSize="15sp"
            android:textColor="#222222"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- 플레이리스트 추가 -->
    <LinearLayout
        android:id="@+id/menuPlaylist"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_menu_playlist"
            android:contentDescription="플레이리스트" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="플레이리스트 추가"
            android:textSize="15sp"
            android:textColor="#222222"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- 공유 -->
    <LinearLayout
        android:id="@+id/menuShare"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_share"
            android:contentDescription="공유" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="공유"
            android:textSize="15sp"
            android:textColor="#222222"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- 이름 변경 -->
    <LinearLayout
        android:id="@+id/menuRename"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_menu_rename"
            android:contentDescription="이름변경" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이름 변경"
            android:textSize="15sp"
            android:textColor="#222222"
            android:layout_marginStart="16dp" />

    </LinearLayout>

</LinearLayout>