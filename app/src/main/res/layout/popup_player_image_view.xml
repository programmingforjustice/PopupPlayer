    android:layout_height="match_parent">

    <!-- 배경 이미지 -->
    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter" />

    <!-- control.xml 레이아웃 오버레이 -->
    <include
        layout="@layout/exo_player_control_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>