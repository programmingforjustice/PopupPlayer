<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/bottom_sheet_multiselect_menu.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:paddingBottom="16dp">

    <!-- 드래그 핸들 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="#DDDDDD"
        android:importantForAccessibility="no" />

    <!-- 모두 선택 -->
    <LinearLayout
        android:id="@+id/menuSelectAll"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/checkbox_on_background"
            android:contentDescription="select all" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="모두 선택"
            android:textSize="15sp"
            android:textColor="#222222"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- 폴더로 이동 -->
    <LinearLayout
        android:id="@+id/menuMoveToFolder"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:contentDescription="move to folder" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="폴더로 이동"
            android:textSize="15sp"
            android:textColor="#222222"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- 폴더로 복사 -->
    <LinearLayout
        android:id="@+id/menuCopyToFolder"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_save"
            android:contentDescription="copy to folder" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="폴더로 복사"
            android:textSize="15sp"
            android:textColor="#222222"
            android:layout_marginStart="16dp" />

    </LinearLayout>

</LinearLayout>