<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/fullscreen_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:controller_layout_id="@layout/fullscreen_player_control_view"
        app:use_controller="true"
        app:show_timeout="3000"
        app:resize_mode="fit" />

    <!-- ── IMAGE MODE ─────────────────────────────────────────── -->

    <!-- Full-screen image view (shown instead of PlayerView for image items) -->
    <ImageView
        android:id="@+id/fullscreen_image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:background="#000000"
        android:contentDescription="Fullscreen image"
        android:visibility="gone" />

    <!-- Control overlay for image items: mimics the video control bar style -->
    <FrameLayout
        android:id="@+id/image_control_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Top bar: back button + title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#66000000"
            android:paddingStart="4dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/image_back_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/image_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingStart="8dp" />

        </LinearLayout>

        <!-- Previous image button -->
        <ImageButton
            android:id="@+id/image_prev_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_skip_previous"
            android:background="#55000000"
            android:visibility="gone"
            android:contentDescription="Previous" />

        <!-- Next image button -->
        <ImageButton
            android:id="@+id/image_next_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_skip_next"
            android:background="#55000000"
            android:visibility="gone"
            android:contentDescription="Next" />

        <!-- Countdown progress bar: drains over 5 seconds before auto-advance -->
        <ProgressBar
            android:id="@+id/slideshow_progress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:max="1000"
            android:progress="1000"
            android:progressTint="#1E90FF"
            android:progressBackgroundTint="#44FFFFFF"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Shown when controls are locked; intercepts all touches -->
    <FrameLayout
        android:id="@+id/fullscreen_lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/fullscreen_unlock_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_lock"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Unlock"
            android:alpha="0.7" />

    </FrameLayout>

</FrameLayout>
