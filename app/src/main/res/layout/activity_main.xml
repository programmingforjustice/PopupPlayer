<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginBottom="60dp">

        <!-- ── TOP APP BAR ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <!-- 뒤로가기 버튼: 루트에서는 gone -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_pp_back"
                android:tint="#65717C"
                android:padding="9dp"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Video&#x2019;s"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#171717"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingStart="0dp" />

            <ImageButton
                android:id="@+id/btnFilterToggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_pp_filter"
                android:tint="#65717C"
                android:padding="8dp"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Filter toggle" />

            <ImageButton
                android:id="@+id/btnSort"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_pp_sort"
                android:tint="#65717C"
                android:padding="8dp"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Sort" />

            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_pp_search"
                android:tint="#65717C"
                android:padding="8dp"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search" />

            <ImageButton
                android:id="@+id/btnLayoutToggle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_pp_grid"
                android:tint="#65717C"
                android:padding="8dp"
                android:scaleType="center"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Layout toggle" />

        </LinearLayout>

        <!-- ── CATEGORY HORIZONTAL SCROLL (루트에서만 보임) ── -->
        <HorizontalScrollView
            android:id="@+id/categoryScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:scrollbars="none"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:id="@+id/categoryPlaylists"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:src="@drawable/ic_pp_playlist"
                        android:tint="#3F7FD8"
                        android:background="@drawable/category_icon_bg_primary"
                        android:padding="12dp"
                        android:scaleType="center"
                        android:contentDescription="My Playlists" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="My Playlist"
                        android:textSize="11sp"
                        android:textColor="#3E4449"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/categoryPlayHistory"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:src="@drawable/ic_pp_history"
                        android:tint="#7C8791"
                        android:background="@drawable/category_icon_bg"
                        android:padding="12dp"
                        android:scaleType="center"
                        android:contentDescription="History" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="History"
                        android:textSize="11sp"
                        android:textColor="#3E4449"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/categoryCleaner"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:src="@drawable/ic_pp_trash"
                        android:tint="#7C8791"
                        android:background="@drawable/category_icon_bg"
                        android:padding="10dp"
                        android:scaleType="center"
                        android:contentDescription="Trash Bin" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Trash Bin"
                        android:textSize="11sp"
                        android:textColor="#3E4449"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/categoryUrlStream"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:src="@drawable/ic_pp_share"
                        android:tint="#7C8791"
                        android:background="@drawable/category_icon_bg"
                        android:padding="12dp"
                        android:scaleType="center"
                        android:contentDescription="URL Stream" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="URL Stream"
                        android:textSize="11sp"
                        android:textColor="#3E4449"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/categorySettings"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:src="@drawable/ic_pp_settings"
                        android:tint="#7C8791"
                        android:background="@drawable/category_icon_bg"
                        android:padding="8dp"
                        android:scaleType="center"
                        android:contentDescription="Settings" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Settings"
                        android:textSize="11sp"
                        android:textColor="#3E4449"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Page indicator dots -->
        <!-- <LinearLayout
            android:id="@+id/layoutDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp">
            <View android:layout_width="6dp" android:layout_height="6dp"
                android:background="@drawable/dot_active" android:layout_marginEnd="4dp" />
            <View android:layout_width="6dp" android:layout_height="6dp"
                android:background="@drawable/dot_inactive" />
        </LinearLayout> -->

        <!-- ── 브레드크럼 (탐색 중에만 표시) ── -->
        <HorizontalScrollView
            android:id="@+id/layoutBreadcrumb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="#FFFFFF"
            android:visibility="gone">
            <TextView
                android:id="@+id/tvBreadcrumb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#8B949E"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:singleLine="true" />
        </HorizontalScrollView>

        <!-- ── 항목 수 + 필터 버튼 그룹 (탐색 중에만 표시) ── -->
        <LinearLayout
            android:id="@+id/layoutFilterBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvItemCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="#7F8891" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_filter_group"
                android:padding="3dp">

                <TextView
                    android:id="@+id/btnFilterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="all"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:background="@drawable/bg_filter_selected"
                    android:textColor="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnFilterVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="video"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:background="@android:color/transparent"
                    android:textColor="#606A74"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnFilterImage"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="image"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:background="@android:color/transparent"
                    android:textColor="#606A74"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E7EBF0" />

        <!-- ── 빈 상태 (파일 없을 때) ── -->
        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:alpha="0.3"
                android:contentDescription="Empty" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="미디어 파일이 없습니다"
                android:textSize="15sp"
                android:textColor="#AAAAAA"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- ── RecyclerView (루트 + 탐색 공용) ── -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFolders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

    <!-- ── BOTTOM NAVIGATION BAR ── -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        app:elevation="8dp"
        app:itemIconTint="@drawable/bottom_nav_selector"
        app:itemTextColor="@drawable/bottom_nav_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

    <!-- ── 멀티셀렉트 플로팅 바 ── -->
    <include
        android:id="@+id/multiselectBar"
        layout="@layout/layout_multiselect_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:visibility="gone" />

    <!-- ── 검색 플로팅 바 ── -->
    <include
        android:id="@+id/searchBar"
        layout="@layout/layout_search_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
